# Multi-tool framework environment configuration
# Copy to `.env` and adjust. Values here are read by python-dotenv.

# --- Metasploit RPC (msfrpcd) -------------------------------------------
# Start the daemon with:
#   msfrpcd -P <password> -a 127.0.0.1 -p 55553
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_PASSWORD=changeme
MSF_RPC_SSL=false
